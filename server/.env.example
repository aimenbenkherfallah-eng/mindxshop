# ---------------------------------------------------------------------------
# Sidahmed Shop — Server Environment Variables
# Copy this file to ".env" and fill in real values. NEVER commit the real ".env".
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/sidahmed_shop

# JSON Web Token
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1d
COOKIE_NAME=sidahmed_admin_token
# Set this to your real domain in production (e.g. ".sidahmedshop.dz") so the
# cookie can be shared across subdomains. Leave blank for localhost.
COOKIE_DOMAIN=

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Seeded admin account (used only by `npm run seed`)
ADMIN_USERNAME=sidahmed
ADMIN_PASSWORD=slhgta62004

# Meta (Facebook) Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Bot protection on the COD order form: "none" | "recaptcha" | "turnstile"
RECAPTCHA_PROVIDER=none
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Public URL where /uploads is served from (used to build absolute image URLs)
SERVER_PUBLIC_URL=http://localhost:5000
